{
  "manifest_version": 3,
  "name": "Snip Talk",
  "version": "0.1.0",
  "description": "Quick launcher for Snip Talk — dictation and snippets, one click away.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Snip Talk",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
